;; Kopioi harrasteprojektisi .agent/config.edn:ksi.
;; Kaikki avaimet ovat valinnaisia; oletukset: src/pipeline/config.clj
{:base-branch "develop"
 :test-cmd "bb test"            ; komento, joka ajetaan ennen PR:ää
 :max-rounds 3
 :max-issues-per-run 3

 :roles {:implementer {:runner :pi
                       ;; Oletus on "opencode-go/minimax-m3". Ajokohtaisesti: --model <malli>
                       :model "opencode-go/minimax-m3"}
         ;; Paikallinen malli myöhemmin, esim. oma wrapper-skripti, joka lukee
         ;; promptin stdinistä:
         ;; :implementer {:runner :command :command ["/home/ansku/bin/local-agent"]}
         :reviewer-a {:model "sonnet"}
         :reviewer-b {:model "opus"}
         :fixer {:model "sonnet"}}

 ;; Prioriteetti labeleista (oletus) tai GitHub Projectista:
 ;; :queue {:source :project
 ;;         :project {:owner "Silvast" :number 1 :field "Priority" :order ["P0" "P1" "P2"]}}

 ;; GitHub Projectin kortti seuraa labelia (Ready, In progress, In review, Done).
 ;; Vaatii: gh auth refresh -s project. Sarakkeet: ks. src/pipeline/config.clj.
 ;; :project-status {:owner "Silvast" :number 2}
 }
